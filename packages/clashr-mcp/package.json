{
  "name": "@clashr/mcp",
  "version": "0.1.0",
  "description": "Local Clashr agent registration, BNB market data, verified quotes and simulation. No transaction submission.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://clashr.trade",
  "bin": {
    "clashr-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pretest": "node scripts/build-plugin.mjs",
    "build": "node scripts/build.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:plugin:schema": "node scripts/check-plugin-schema.mjs",
    "check:plugin:codex": "node scripts/check-plugin-client.mjs",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "viem": "^2.57.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rushr/trade": "workspace:*",
    "@rushr/agents": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
